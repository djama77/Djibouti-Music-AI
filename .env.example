# Set a long random application token. Do not commit your real .env file.
APP_ACCESS_TOKEN=replace-with-a-long-random-secret
# URL of your separately hosted ACE-Step 1.5 API (GPU server)
ACESTEP_BASE_URL=http://gpu-server.example:8001
ACESTEP_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
